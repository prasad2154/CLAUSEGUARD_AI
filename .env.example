# =============================================
# ClauseGuard AI — Environment Configuration
# =============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# -----------------------------------------------
# LLM Configuration
# -----------------------------------------------
# Provider: openai | azure | ollama
LLM_PROVIDER=openai

# OpenAI API Key (required for openai/azure providers)
OPENAI_API_KEY = "[ENCRYPTION_KEY]"

# OpenAI Base URL (override for Azure OpenAI or local Ollama)
# Azure example: https://your-resource.openai.azure.com/
# Ollama example: http://localhost:11434/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# LLM Model name
# OpenAI: gpt-4o-mini | gpt-4o | gpt-4-turbo
# Ollama: llama3 | mistral | qwen2.5
LLM_MODEL=gpt-4o-mini

# LLM Temperature (0.0 - 1.0)
LLM_TEMPERATURE=0.1

# -----------------------------------------------
# Embedding Configuration
# -----------------------------------------------
# Local sentence-transformers model (no API key required)
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# -----------------------------------------------
# Database Configuration
# -----------------------------------------------
DATABASE_URL=postgresql://clauseguard:clauseguard@postgres:5432/clauseguard

# For local development without Docker:
# DATABASE_URL=postgresql://clauseguard:clauseguard@localhost:5432/clauseguard

# -----------------------------------------------
# Qdrant Vector Database
# -----------------------------------------------
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=contract_clauses

# For local development without Docker:
# QDRANT_HOST=localhost

# -----------------------------------------------
# Application Security
# -----------------------------------------------
SECRET_KEY=change-this-to-a-long-random-string-in-production

# -----------------------------------------------
# File Upload Configuration
# -----------------------------------------------
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=./uploads
ALLOWED_EXTENSIONS=pdf,docx,doc,png,jpg,jpeg,tiff

# -----------------------------------------------
# Backend Server
# -----------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=false

# -----------------------------------------------
# Frontend Configuration
# -----------------------------------------------
VITE_API_URL=http://localhost:8000

# -----------------------------------------------
# CORS Configuration
# -----------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://frontend:80

# -----------------------------------------------
# Logging
# -----------------------------------------------
LOG_LEVEL=INFO

# -----------------------------------------------
# Processing Configuration
# -----------------------------------------------
# Maximum clauses to process per document
MAX_CLAUSES_PER_DOC=500
# OCR confidence threshold (0-100)
OCR_CONFIDENCE_THRESHOLD=60
# Minimum text length to skip OCR
MIN_TEXT_LENGTH_FOR_OCR_SKIP=100
